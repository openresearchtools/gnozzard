    <key name="previous-application-view-keybinding" type="as"><default>[]</default></key>
    <key name="lock-settings-owned" type="b"><default>false</default></key>
    <key name="previous-lock-picture-uri" type="s"><default>''</default></key>
    <key name="previous-lock-picture-options" type="s"><default>'zoom'</default></key>
    <key name="previous-lock-color-shading-type" type="s"><default>'solid'</default></key>
    <key name="previous-lock-primary-color" type="s"><default>'#000000'</default></key>
    <key name="previous-lock-secondary-color" type="s"><default>'#000000'</default></key>
  </schema>
</schemalist>
