<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.openresearchtools.gnozzard" path="/org/openresearchtools/gnozzard/">
    <key name="panel-color" type="s">
      <default>'#282828'</default>
      <summary>Solid panel colour</summary>
    </key>
    <key name="pinned-apps" type="as">
      <default>[]</default>
      <summary>Desktop IDs pinned to the bottom of the Applications menu</summary>
    </key>
    <key name="show-resources-button" type="b">
      <default>true</default>
      <summary>Show the Resources launcher beside top-bar status items</summary>
    </key>
    <key name="taskbars-all-displays" type="b">
      <default>true</default>
      <summary>Show the complete taskbar on every connected display</summary>
    </key>
    <key name="capped-task-buttons" type="b">
      <default>true</default>
      <summary>Cap complete task buttons beside Applications</summary>
    </key>
    <key name="taskbar-all-workspaces" type="b">
      <default>false</default>
      <summary>Show windows from every workplace on the taskbar</summary>
    </key>
    <key name="toggle-applications" type="as">
      <default><![CDATA[['<Super>a']]]></default>
      <summary>Open the Applications menu</summary>
